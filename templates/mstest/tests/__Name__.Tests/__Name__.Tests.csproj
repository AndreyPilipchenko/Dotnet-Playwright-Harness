<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright.MSTest.v4" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- One JSON file per test class; TestData.Load reads them from testData/ next to the binaries. -->
    <None Include="..\..\resources\testData\**\*.json" LinkBase="testData" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\{{Name}}.Framework\{{Name}}.Framework.csproj" />
  </ItemGroup>

</Project>
