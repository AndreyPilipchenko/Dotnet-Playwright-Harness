<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- Test names use Subject_Behaviour_Condition underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Harness.Tools\Harness.Tools.csproj" />
  </ItemGroup>

  <!--
    The skeleton's Redaction.cs is compiled into this assembly as HarnessTemplates.Framework.Utils,
    so Templates/RedactionTests.cs runs the real template code. It is marked generated: the
    consumer project's analyzers govern template code, not these.
  -->
  <PropertyGroup>
    <RedactionTemplate>$(MSBuildThisFileDirectory)..\..\templates\framework\src\__Name__.Framework\Utils\Redaction.cs</RedactionTemplate>
    <!-- BaseIntermediateOutputPath (obj\) is set before the project body and is outside the default Compile glob. -->
    <RedactionRendered>$(BaseIntermediateOutputPath)HarnessTemplates\Redaction.g.cs</RedactionRendered>
  </PropertyGroup>

  <!-- A C# task, because the template's regexes hold quotes and semicolons that MSBuild property functions would mangle. -->
  <UsingTask TaskName="RenderHarnessTemplate" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = "// <auto-generated/>\n#nullable enable\n" + File.ReadAllText(Source).Replace("{{Name}}", "HarnessTemplates");
        Directory.CreateDirectory(Path.GetDirectoryName(Destination));
        if (!File.Exists(Destination) || File.ReadAllText(Destination) != text)
        {
            File.WriteAllText(Destination, text);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="RenderRedactionTemplate" Inputs="$(RedactionTemplate)" Outputs="$(RedactionRendered)">
    <RenderHarnessTemplate Source="$(RedactionTemplate)" Destination="$(RedactionRendered)" />
  </Target>

  <Target Name="IncludeRedactionTemplate" BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="RenderRedactionTemplate">
    <ItemGroup>
      <Compile Include="$(RedactionRendered)" />
      <FileWrites Include="$(RedactionRendered)" />
    </ItemGroup>
  </Target>

</Project>
